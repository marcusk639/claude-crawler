# Copy this file to .env and fill in your values
# cp env.example .env

# GitHub Personal Access Token (highly recommended)
# Without this: 60 req/hour. With it: 5000/hour
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Google Custom Search (optional — enables web search, 100 free queries/day)
# Step 1 — API key: https://console.cloud.google.com → APIs → Custom Search API → Credentials
# Step 2 — CSE ID:  https://programmablesearchengine.google.com → New engine → Search the entire web → Copy the "cx" value
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Server port (default: 3737)
PORT=3737

# Cache TTL in minutes (default: 60)
CACHE_TTL_MINUTES=60

# Optional: protects POST /api/catalog/refresh from unauthenticated calls.
# Without this, the endpoint is open (fine for local-only use).
# REFRESH_SECRET=change-me

# ── LLM scoring (optional) ───────────────────────────────────────────────────
# Enables intelligent README-based scoring. Without these, heuristic scoring
# is used (no breaking change).
#
# Free option: Hermes 3 405B on OpenRouter (no credit card required)
#   LLM_API_KEY=sk-or-...       # Get free key at openrouter.ai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b-instruct:free
#
# Paid option (better quality): Hermes 4 70B at $0.13/M input tokens
#   LLM_MODEL=nousresearch/hermes-4-405b
#
# Local option (fully private, requires Ollama + ~25GB RAM):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=hf.co/NousResearch/Hermes-4.3-36B-GGUF:Q4_K_M
#   (also set: OLLAMA_NUM_CTX=32768 — Ollama defaults to 4K which is too small)
#
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b-instruct:free
